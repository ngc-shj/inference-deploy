diff --git a/metal/flash_attn.metal b/metal/flash_attn.metal
index acc6b49..ace3289 100644
--- a/metal/flash_attn.metal
+++ b/metal/flash_attn.metal
@@ -1390,6 +1390,427 @@ typedef decltype(kernel_flash_attn_ext_vec<FA_TYPES, half4, 1, dequantize_f16_t4
 // Host-visible decode FlashAttention variant for DS4's 512-wide F16 K/V rows.
 template [[host_name("kernel_flash_attn_ext_vec_f16_dk512_dv512")]]  kernel flash_attn_ext_vec_t kernel_flash_attn_ext_vec<FA_TYPES,     half4,  1, dequantize_f16_t4, half4,  1, dequantize_f16_t4, 512, 512, 1>;
 
+// The decode FlashAttention above with HT query heads to a threadgroup
+// instead of one. Every head reads the same shared K/V rows, so with one head
+// a threadgroup each key chunk is fetched from L2 once per head; here it is
+// fetched once per HT heads and the other heads find it in the threadgroup's
+// cache. Inside a chunk the heads are taken one after another, each with its
+// own running max, sum and output rows, and every head's arithmetic is the
+// kernel above's in the same order: the same keys, the same FMAs, the same
+// reductions. Nothing is reduced across heads.
+template<
+    typename q4_t,
+    typename k4_t,
+    typename v4_t,
+    typename qk_t,
+    typename s_t,
+    typename s4_t,
+    typename o4_t,
+    typename kd4_t,
+    short nl_k,
+    void (*deq_k_t4)(device const kd4_t *, short, thread k4_t &),
+    typename vd4_t,
+    short nl_v,
+    void (*deq_v_t4)(device const vd4_t *, short, thread v4_t &),
+    short DK,
+    short DV,
+    short HT,
+    short NE = 4,
+    short C  = OP_FLASH_ATTN_EXT_VEC_NCPSG>
+kernel void kernel_flash_attn_ext_vec_ht(
+        constant ds4_metal_args_flash_attn_ext_vec & args,
+        device const char * q,
+        device const char * k,
+        device const char * v,
+        device const char * mask,
+        device const char * sinks,
+        device const char * pad,
+        device       char * dst,
+        threadgroup  half * shmem_f16 [[threadgroup(0)]],
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]]) {
+    static_assert(DK % 32 == 0, "DK must be divisible by 32");
+    static_assert(DV % 32 == 0, "DV must be divisible by 32");
+
+#define NWG  (FC_flash_attn_ext_vec_nwg)
+#define NSG  (FC_flash_attn_ext_vec_nsg)
+#define NS10 (FC_flash_attn_ext_vec_ns10)
+#define NS20 (FC_flash_attn_ext_vec_ns20)
+
+    const short iwg = tgpig[2]%NWG;
+
+    const ushort iq3 = tgpig[2]/NWG;
+    const ushort ih0 = tgpig[1]*HT;
+    const ushort iq1 = tgpig[0];
+
+    constexpr short DK4 = DK/4;
+    constexpr short DV4 = DV/4;
+    constexpr short PK  = PAD2(DK, 128);
+    constexpr short PK4 = PK/4;
+    constexpr short PV  = PAD2(DV, 128);
+    constexpr short PV4 = PV/4;
+    constexpr short NW  = N_SIMDWIDTH;
+    constexpr short NL  = NW/NE;
+    constexpr short SH  = 4*C;
+
+    static_assert(DK4 % NL == 0, "DK4 must be divisible by NL");
+    static_assert(DV4 % NL == 0, "DV4 must be divisible by NL");
+
+    /* HT query rows, then each simdgroup's scores and mask, then each head's
+     * output rows per simdgroup, then each head's (S, M) per simdgroup. */
+    threadgroup q4_t  * sq4 = (threadgroup q4_t  *) (shmem_f16);
+    threadgroup s_t   * ss  = (threadgroup s_t   *) (shmem_f16 + HT*PK + sgitg*SH);
+    threadgroup s4_t  * ss4 = (threadgroup s4_t  *) (shmem_f16 + HT*PK + sgitg*SH);
+    threadgroup half  * sm  = (threadgroup half  *) (shmem_f16 + HT*PK + sgitg*SH + 2*C);
+    threadgroup o4_t  * so4b = (threadgroup o4_t *) (shmem_f16 + HT*PK + NSG*SH);
+    threadgroup float * shm = (threadgroup float *) (shmem_f16 + HT*PK + NSG*SH + HT*NSG*2*PV);
+
+    device const char * kbase;
+    device const char * vbase;
+    {
+        const short ikv2 = ih0/(args.ne02/args.ne_12_2);
+        const short ikv3 = iq3/(args.ne03/args.ne_12_3);
+
+        kbase = k + ikv2*args.nb12 + ikv3*args.nb13;
+        vbase = v + ikv2*args.nb22 + ikv3*args.nb23;
+    }
+
+    if (iq1 < args.ne01) {
+        for (short h = 0; h < HT; ++h) {
+            device const float4 * q4 = (device const float4 *)
+                (q + iq1*args.nb01 + (ih0 + h)*args.nb02 + iq3*args.nb03);
+            for (short i = tiisg; i < PK4; i += NW) {
+                if (i < DK4) {
+                    sq4[h*PK4 + i] = (q4_t) q4[i];
+                } else {
+                    sq4[h*PK4 + i] = (q4_t) 0.0f;
+                }
+            }
+        }
+    }
+
+    for (short h = 0; h < HT; ++h) {
+        threadgroup o4_t * so4 = so4b + (h*NSG + sgitg)*PV4 + tiisg;
+        for (short i = 0; i < DV4/NL; ++i) {
+            so4[i*NL] = (o4_t) 0.0f;
+        }
+    }
+
+    for (short i = tiisg; i < SH/4; i += NW) {
+        ss4[i] = (s4_t) 0.0f;
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    {
+        float S[HT];
+        float M[HT];
+        for (short h = 0; h < HT; ++h) {
+            S[h] = 0.0f;
+            M[h] = -FLT_MAX/2;
+        }
+
+        const short tx = tiisg%NL;
+        const short ty = tiisg/NL;
+
+        device const char * kk = kbase;
+        device const char * vv = vbase;
+        device const char * mk = mask;
+
+        device const half * pm = (device const half *) (mask + iq1*args.nb31 + (ih0%args.ne32)*args.nb32 + (iq3%args.ne33)*args.nb33);
+
+        for (int ic0 = iwg*NSG + sgitg; ; ic0 += NWG*NSG) {
+            int ic = ic0*C;
+            if (ic >= args.ne11) {
+                break;
+            }
+
+            if (FC_flash_attn_ext_vec_has_kvpad && ic + C > args.ne11) {
+                kk   = pad;
+                if (FC_flash_attn_ext_vec_shared_kvpad) {
+                    vv = kk;
+                    mk = kk + args.nb11*C*args.ne_12_2*args.ne_12_3 +
+                        args.nb21*C*args.ne_12_2*args.ne_12_3;
+                } else {
+                    vv = kk + args.nb11*C*args.ne_12_2*args.ne_12_3;
+                    mk = vv + args.nb21*C*args.ne_12_2*args.ne_12_3;
+                }
+
+                const short ikv2 = ih0/(args.ne02/args.ne_12_2);
+                const short ikv3 = iq3/(args.ne03/args.ne_12_3);
+
+                kk += (ikv2 + ikv3*args.ne_12_2)*args.nb11*C;
+                vv += (ikv2 + ikv3*args.ne_12_2)*args.nb21*C;
+
+                if (!FC_flash_attn_ext_vec_has_mask) {
+                    if (ic + tiisg >= args.ne11) {
+                        sm[tiisg] = -MAXHALF;
+                    }
+                } else {
+                    pm = (device const half *) (mk) +
+                        iq1*C +
+                        (ih0%args.ne32)*(C*args.ne31) +
+                        (iq3%args.ne33)*(C*args.ne31*args.ne32);
+                }
+
+                ic = 0;
+            }
+
+            if (FC_flash_attn_ext_vec_has_mask) {
+                sm[tiisg] = pm[ic + tiisg];
+            }
+
+            if (simd_max(sm[tiisg]) <= -MAXHALF) {
+                continue;
+            }
+
+            for (short h = 0; h < HT; ++h) {
+                threadgroup o4_t * so4 = so4b + (h*NSG + sgitg)*PV4 + tiisg;
+                {
+                    device      const k4_t * pk4 = (device const k4_t *) (kk + ic*args.nb11);
+                    threadgroup const q4_t * pq4 = sq4 + h*PK4;
+
+                    pk4 += ty*NS10/4 + tx;
+                    pq4 += tx;
+
+                    qk_t mqk[C/NE] = { [ 0 ... C/NE - 1] = 0.0f };
+
+                    FOR_UNROLL (short cc = 0; cc < C/NE; ++cc) {
+                        FOR_UNROLL (short ii = 0; ii < DK4/NL; ++ii) {
+                            mqk[cc] += dot((float4) pk4[cc*NE*NS10/4 +  ii*NL], (float4) pq4[ii*NL]);
+                        }
+
+                        if (NE == 1) {
+                            mqk[cc] = simd_sum(mqk[cc]);
+                        } else {
+                            if (NE <= 1) {
+                                mqk[cc] += simd_shuffle_down(mqk[cc], 16);
+                            }
+                            if (NE <= 2) {
+                                mqk[cc] += simd_shuffle_down(mqk[cc],  8);
+                            }
+                            if (NE <= 4) {
+                                mqk[cc] += simd_shuffle_down(mqk[cc],  4);
+                            }
+                            if (NE <= 8) {
+                                mqk[cc] += simd_shuffle_down(mqk[cc],  2);
+                            }
+                            if (NE <= 16) {
+                                mqk[cc] += simd_shuffle_down(mqk[cc],  1);
+                            }
+
+                            mqk[cc] = simd_shuffle(mqk[cc], NL*ty);
+                        }
+                    }
+
+                    if (FC_flash_attn_ext_vec_has_mask &&
+                       !FC_flash_attn_ext_vec_has_scap &&
+                       !FC_flash_attn_ext_vec_has_bias) {
+                        ss[NE*tx + ty] = fma(mqk[tx], args.scale, (qk_t) sm[NE*tx + ty]);
+                    } else {
+                        mqk[tx] *= args.scale;
+
+                        if (FC_flash_attn_ext_vec_has_scap) {
+                            mqk[tx] = args.logit_softcap*precise::tanh(mqk[tx]);
+                        }
+
+                        mqk[tx] += (qk_t) sm[NE*tx + ty];
+
+                        ss[NE*tx + ty] = mqk[tx];
+                    }
+                }
+
+                simdgroup_barrier(mem_flags::mem_threadgroup);
+
+                {
+                    const float m = M[h];
+                    const float s = ss[tiisg];
+
+                    M[h] = simd_max(max(M[h], s));
+
+                    const float ms = exp(m - M[h]);
+                    const float vs = exp(s - M[h]);
+
+                    S[h] = S[h]*ms + simd_sum(vs);
+
+                    ss[tiisg] = vs;
+
+                    if ((DV4/NL % NW == 0) || ty == 0) {
+                        FOR_UNROLL (short ii = 0; ii < DV4/NL; ++ii) {
+                            so4[ii*NL] *= ms;
+                        }
+                    }
+                }
+
+                simdgroup_barrier(mem_flags::mem_threadgroup);
+
+                {
+                    o4_t lo[DV4/NL];
+                    FOR_UNROLL (short ii = 0; ii < DV4/NL; ++ii) {
+                        lo[ii] = 0.0f;
+                    }
+
+                    device const v4_t * pv4 = (device const v4_t *) (vv + ic*args.nb21);
+
+                    pv4 += ty*NS20/4 + tx;
+
+                    const auto sst = ss + ty;
+
+                    FOR_UNROLL (short cc = 0; cc < C/NE; ++cc) {
+                        FOR_UNROLL (short ii = 0; ii < DV4/NL; ++ii) {
+                            lo[ii] += o4_t(float4(pv4[cc*NE*NS20/4 + ii*NL])*float4(sst[cc*NE]));
+                        }
+                    }
+
+                    FOR_UNROLL (short ii = 0; ii < DV4/NL; ++ii) {
+                        if (NE > 1) {
+                            lo[ii][0] += simd_shuffle_down(lo[ii][0], 16);
+                            lo[ii][1] += simd_shuffle_down(lo[ii][1], 16);
+                            lo[ii][2] += simd_shuffle_down(lo[ii][2], 16);
+                            lo[ii][3] += simd_shuffle_down(lo[ii][3], 16);
+                        }
+
+                        if (NE > 2) {
+                            lo[ii][0] += simd_shuffle_down(lo[ii][0],  8);
+                            lo[ii][1] += simd_shuffle_down(lo[ii][1],  8);
+                            lo[ii][2] += simd_shuffle_down(lo[ii][2],  8);
+                            lo[ii][3] += simd_shuffle_down(lo[ii][3],  8);
+                        }
+
+                        if (NE > 4) {
+                            lo[ii][0] += simd_shuffle_down(lo[ii][0],  4);
+                            lo[ii][1] += simd_shuffle_down(lo[ii][1],  4);
+                            lo[ii][2] += simd_shuffle_down(lo[ii][2],  4);
+                            lo[ii][3] += simd_shuffle_down(lo[ii][3],  4);
+                        }
+
+                        if (NE > 8) {
+                            lo[ii][0] += simd_shuffle_down(lo[ii][0],  2);
+                            lo[ii][1] += simd_shuffle_down(lo[ii][1],  2);
+                            lo[ii][2] += simd_shuffle_down(lo[ii][2],  2);
+                            lo[ii][3] += simd_shuffle_down(lo[ii][3],  2);
+                        }
+
+                        if (NE > 16) {
+                            lo[ii][0] += simd_shuffle_down(lo[ii][0],  1);
+                            lo[ii][1] += simd_shuffle_down(lo[ii][1],  1);
+                            lo[ii][2] += simd_shuffle_down(lo[ii][2],  1);
+                            lo[ii][3] += simd_shuffle_down(lo[ii][3],  1);
+                        }
+                    }
+
+                    if ((DV4/NL % NW == 0) || ty == 0) {
+                        FOR_UNROLL (short ii = 0; ii < DV4/NL; ++ii) {
+                            so4[ii*NL] += lo[ii];
+                        }
+                    }
+                }
+
+                /* The next head overwrites the scores this one just read. */
+                simdgroup_barrier(mem_flags::mem_threadgroup);
+            }
+        }
+
+        for (short h = 0; h < HT; ++h) {
+            threadgroup o4_t * so4 = so4b + (h*NSG + sgitg)*PV4 + tiisg;
+            if (FC_flash_attn_ext_vec_has_sinks && sgitg == 0 && iwg == 0) {
+                const float m = M[h];
+                const float s = tiisg == 0 ? ((device const float *) sinks)[ih0 + h] : -FLT_MAX/2;
+
+                M[h] = simd_max(max(M[h], s));
+
+                const float ms = exp(m - M[h]);
+                const float vs = exp(s - M[h]);
+
+                S[h] = S[h]*ms + simd_sum(vs);
+
+                if ((DV4/NL % NW == 0) || ty == 0) {
+                    FOR_UNROLL (short ii = 0; ii < DV4/NL; ++ii) {
+                        so4[ii*NL] *= ms;
+                    }
+                }
+            }
+
+            if (tiisg == 0) {
+                shm[(h*NSG + sgitg)*2 + 0] = S[h];
+                shm[(h*NSG + sgitg)*2 + 1] = M[h];
+            }
+        }
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (short h = 0; h < HT; ++h) {
+        threadgroup o4_t  * so4 = so4b + (h*NSG + sgitg)*PV4;
+        threadgroup float * hsm = shm + (h*NSG + sgitg)*2;
+        for (short r = NSG/2; r > 0; r >>= 1) {
+            if (sgitg < r) {
+                const float S0 = hsm[    0];
+                const float S1 = hsm[r*2 + 0];
+
+                const float M0 = hsm[    1];
+                const float M1 = hsm[r*2 + 1];
+
+                const float Mx = max(M0, M1);
+
+                const float ms0 = exp(M0 - Mx);
+                const float ms1 = exp(M1 - Mx);
+
+                const float Sx = S0*ms0 + S1*ms1;
+
+                if (tiisg == 0) {
+                    hsm[0] = Sx;
+                    hsm[1] = Mx;
+                }
+
+                for (short i = tiisg; i < DV4; i += NW) {
+                    so4[i] = so4[i]*ms0 + so4[i + r*PV4]*ms1;
+                }
+            }
+
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+
+        if (sgitg == 0) {
+            const int64_t nrows = args.ne3*args.ne2*args.ne1;
+            const int64_t rid   = iq3*args.ne2*args.ne1 + (ih0 + h) + iq1*args.ne1;
+
+            device float4 * dst4 = (device float4 *) dst;
+            device float  * dst1 = (device float  *) dst + nrows*DV*NWG;
+
+            const float Sd = NWG == 1 ? (hsm[0] == 0.0f ? 0.0f : 1.0f/hsm[0]) : 1.0f;
+
+            for (short i = tiisg; i < DV4; i += NW) {
+                dst4[rid*DV4*NWG + NWG*i + iwg] = (float4) so4[i]*Sd;
+            }
+
+            if (NWG > 1) {
+                if (tiisg == 0) {
+                    dst1[rid*(2*NWG) + 2*iwg + 0] = hsm[0];
+                    dst1[rid*(2*NWG) + 2*iwg + 1] = hsm[1];
+                }
+            }
+        }
+    }
+
+#undef NWG
+#undef NSG
+#undef NS10
+#undef NS20
+}
