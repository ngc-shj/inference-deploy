+/* abcf:multi:<tokens> - the decode attention's counterfactual replay, every
+ * arm in one process against one kept pass per token. The untimed pass keeps
+ * each layer's staged K/V, mask and pad, its vec partials and its output; the
+ * arms then leave out one group each and read what was kept. The order runs
+ * forward on even tokens and backward on odd ones, so every arm is measured in
+ * both positions, and each arm's logits are compared with the kept pass's in
+ * full. Arms 3 and 4 copy the kept output in with one blit a call, which the
+ * last arm prices on its own. */
+static void ds41_attn_cf_multi(ds4_session *seed, const ds4_model *m, const ds4_weights *w,
+                               long n) {
+    enum { WARM = 4, ARMS = 6 };
+    static const int mode[ARMS] = { 0, 2, 5, 6, 3, 4 };
+    static const char *name[ARMS] = {
+        "control (all run)          ", "staging and pad left out   ", "vec left out               ",
+        "reduce left out (+1 blit)  ", "vec and reduce out (+1 blit)", "control plus the blit      " };
+    ds4_engine *e = seed->engine;
+    ds4_tokens prompt = { .v = seed->checkpoint.v, .len = seed->checkpoint.len,
+                          .cap = seed->checkpoint.cap };
+    ds4_session *s = NULL;
+    float *lg = malloc((size_t)DS4_N_VOCAB * sizeof(float));
+    float *ref = malloc((size_t)DS4_N_VOCAB * sizeof(float));
+    float *carry = malloc((size_t)3u * 2u * 512u * sizeof(float));
+    double ms[ARMS] = {0}, oms[2][ARMS] = {{0}}, ctl[512];
+    long runs[ARMS] = {0}, oruns[2][ARMS] = {{0}}, differ[ARMS] = {0}, ctl_n = 0;
+    unsigned long long cnt[ARMS][4] = {{0}};
+    if (!lg || !ref || !carry || n < 1 ||
+        !ds41_txn_prefill(&s, e, &prompt, seed->ctx_size, "attention replay")) goto done;
+    ds41_gpu_graph *g = &s->ds41_graph;
+    int token = sample_argmax(s->logits, DS4_N_VOCAB);
+    for (long t = 0; t < n; t++) {
+        const uint32_t pos0 = g->pos;
+        const ds4_engram_history hist0 = g->history;
+        if (!ds4_gpu_synchronize()) goto done;
+        for (uint32_t ci = 0; ci < 3; ci++)
+            if (!ds4_gpu_tensor_read(g->previous_kv[ci], 0, carry + (size_t)ci * 1024u, 2048u) ||
+                !ds4_gpu_tensor_read(g->previous_score[ci], 0, carry + (size_t)ci * 1024u + 512u, 2048u))
+                goto done;
+        for (int a = -1; a < ARMS; a++) {
+            const int arm = a < 0 ? 0 : (t & 1) ? ARMS - 1 - a : a;
+            g->pos = pos0; g->history = hist0; g->valid = true;
+            (void)ds4_gpu_synchronize();
+            for (uint32_t ci = 0; ci < 3; ci++) {
+                (void)ds4_gpu_tensor_write(g->previous_kv[ci], 0, carry + (size_t)ci * 1024u, 2048u);
+                (void)ds4_gpu_tensor_write(g->previous_score[ci], 0, carry + (size_t)ci * 1024u + 512u, 2048u);
+            }
+            ds4_gpu_attn_cf_mode(a < 0 ? 1 : mode[arm]);
+            unsigned long long c0[4], c1[4];
+            ds4_gpu_attn_counts(c0);
+            const double t0 = now_sec();
+            const bool ok = ds41_graph_step(g, m, w, token, lg);
+            const double dt = (now_sec() - t0) * 1e3;
+            ds4_gpu_attn_counts(c1);
+            if (!ok) goto done;
+            if (a < 0) {
+                memcpy(ref, lg, (size_t)DS4_N_VOCAB * sizeof(float));
+                continue;
+            }
+            if (memcmp(ref, lg, (size_t)DS4_N_VOCAB * sizeof(float)) != 0) differ[arm]++;
+            if (t >= WARM) {
+                ms[arm] += dt; runs[arm]++;
+                oms[t & 1][arm] += dt; oruns[t & 1][arm]++;
+                for (int c = 0; c < 4; c++) cnt[arm][c] += c1[c] - c0[c];
+                if (arm == 0 && ctl_n < 512) ctl[ctl_n++] = dt;
+            }
+        }
+        ds4_gpu_attn_cf_mode(0);
+        token = sample_argmax(lg, DS4_N_VOCAB);
+    }
+    {
+        double f = 0, l = 0;
+        const long k = ctl_n >= 8 ? 4 : ctl_n / 2;
+        for (long i = 0; i < k; i++) { f += ctl[i]; l += ctl[ctl_n - 1 - i]; }
+        fprintf(stderr, "ds4: attention replay from position %d over %ld tokens; control first "
+                "%ld steps %.2f ms, last %ld %.2f ms\n", prompt.len, n, k, k ? f / k : 0.0,
+                k, k ? l / k : 0.0);
+    }
+    for (int arm = 0; arm < ARMS; arm++) {
+        const double r = runs[arm] ? (double)runs[arm] : 1.0;
+        const double fwd = oruns[0][arm] ? oms[0][arm] / oruns[0][arm] : 0.0;
+        const double bwd = oruns[1][arm] ? oms[1][arm] / oruns[1][arm] : 0.0;
+        const double fwd0 = oruns[0][0] ? oms[0][0] / oruns[0][0] : 0.0;
+        const double bwd0 = oruns[1][0] ? oms[1][0] / oruns[1][0] : 0.0;
+        fprintf(stderr, "ds4:   %s %.2f ms a step (minus control %+.2f: forward %+.2f, "
+                "backward %+.2f); a step %.1f calls, %.1f replayed, %.1f missing; logits "
+                "differed %ld of %ld\n", name[arm], ms[arm] / r,
+                ms[arm] / r - (runs[0] ? ms[0] / runs[0] : 0.0), fwd - fwd0, bwd - bwd0,
+                cnt[arm][0] / r, cnt[arm][2] / r, cnt[arm][3] / r, differ[arm],
+                n);
+    }
+done:
+    ds4_gpu_attn_cf_mode(0);
+    if (s) ds4_session_free(s);
+    free(lg); free(ref); free(carry);
+}
