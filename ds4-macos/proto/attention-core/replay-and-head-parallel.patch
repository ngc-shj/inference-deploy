+/* abhp:<tokens> - the decode attention's vec with 1, 2, 4 and 8 heads to a
+ * threadgroup (one simdgroup a head), in one process. Per token: an untimed
+ * pass with one head keeps every layer's vec partials; one untimed check pass
+ * for each tile copies its partials aside and they are compared with the kept
+ * ones in full; then the four arms are timed, forward on even tokens and
+ * backward on odd ones, each arm's logits compared in full with the kept
+ * pass's, and the threadgroups each arm launched counted. */
+extern void ds4_gpu_set_attn_head_par(uint32_t heads);
+extern unsigned long long ds4_gpu_attn_vec_tgs(void);
+extern void ds4_gpu_attn_check(unsigned long long out[3]);
+/* abhp:perf:<tokens> is the same with nothing but the arms: no keeping, no
+ * check passes, no copies - the untimed pass only warms the cache. */
+static void ds41_attn_hp_ab(ds4_session *seed, const ds4_model *m, const ds4_weights *w, long n,
+                            bool perf) {
+    enum { WARM = 4, ARMS = 4 };
+    static const uint32_t tile[ARMS] = { 1, 2, 4, 8 };
+    ds4_engine *e = seed->engine;
+    ds4_tokens prompt = { .v = seed->checkpoint.v, .len = seed->checkpoint.len,
+                          .cap = seed->checkpoint.cap };
+    ds4_session *s = NULL;
+    float *lg = malloc((size_t)DS4_N_VOCAB * sizeof(float));
+    float *ref = malloc((size_t)DS4_N_VOCAB * sizeof(float));
+    float *carry = malloc((size_t)3u * 2u * 512u * sizeof(float));
+    double ms[ARMS] = {0}, oms[2][ARMS] = {{0}}, ctl[512];
+    long runs[ARMS] = {0}, oruns[2][ARMS] = {{0}}, differ[ARMS] = {0}, ctl_n = 0;
+    unsigned long long tgs[ARMS] = {0}, chk[ARMS][3] = {{0}};
+    if (!lg || !ref || !carry || n < 1 ||
+        !ds41_txn_prefill(&s, e, &prompt, seed->ctx_size, "head tile")) goto done;
+    ds41_gpu_graph *g = &s->ds41_graph;
+    int token = sample_argmax(s->logits, DS4_N_VOCAB);
+    for (long t = 0; t < n; t++) {
+        const uint32_t pos0 = g->pos;
+        const ds4_engram_history hist0 = g->history;
+        if (!ds4_gpu_synchronize()) goto done;
+        for (uint32_t ci = 0; ci < 3; ci++)
+            if (!ds4_gpu_tensor_read(g->previous_kv[ci], 0, carry + (size_t)ci * 1024u, 2048u) ||
+                !ds4_gpu_tensor_read(g->previous_score[ci], 0, carry + (size_t)ci * 1024u + 512u, 2048u))
+                goto done;
+        /* -1 keeps, -2..-4 check tiles 2, 4, 8, then the four timed arms */
+        for (int a = perf ? -1 : -4; a < ARMS; a++) {
+            const bool keep = perf ? a == -1 : a == -4, check = !perf && a > -4 && a < 0;
+            const int arm = keep ? 0 : check ? -a : (t & 1) ? ARMS - 1 - a : a;
+            g->pos = pos0; g->history = hist0; g->valid = true;
+            (void)ds4_gpu_synchronize();
+            for (uint32_t ci = 0; ci < 3; ci++) {
+                (void)ds4_gpu_tensor_write(g->previous_kv[ci], 0, carry + (size_t)ci * 1024u, 2048u);
+                (void)ds4_gpu_tensor_write(g->previous_score[ci], 0, carry + (size_t)ci * 1024u + 512u, 2048u);
+            }
+            ds4_gpu_attn_cf_mode(perf ? 0 : keep ? 1 : check ? 7 : 0);
+            ds4_gpu_set_attn_head_par(tile[arm]);
+            const unsigned long long tg0 = ds4_gpu_attn_vec_tgs();
+            const double t0 = now_sec();
+            const bool ok = ds41_graph_step(g, m, w, token, lg);
+            const double dt = (now_sec() - t0) * 1e3;
+            const unsigned long long tg1 = ds4_gpu_attn_vec_tgs();
+            if (!ok) goto done;
+            if (keep) { memcpy(ref, lg, (size_t)DS4_N_VOCAB * sizeof(float)); continue; }
+            if (memcmp(ref, lg, (size_t)DS4_N_VOCAB * sizeof(float)) != 0) differ[arm]++;
+            if (check) {
+                unsigned long long c[3];
+                (void)ds4_gpu_synchronize();
+                ds4_gpu_attn_check(c);
+                for (int k = 0; k < 3; k++) chk[arm][k] += c[k];
+                continue;
+            }
+            if (t >= WARM) {
+                ms[arm] += dt; runs[arm]++;
+                oms[t & 1][arm] += dt; oruns[t & 1][arm]++;
+                tgs[arm] += tg1 - tg0;
+                if (arm == 0 && ctl_n < 512) ctl[ctl_n++] = dt;
+            }
+        }
+        ds4_gpu_attn_cf_mode(0);
+        ds4_gpu_set_attn_head_par(0);
+        token = sample_argmax(lg, DS4_N_VOCAB);
+    }
+    {
+        double f = 0, l = 0;
+        const long k = ctl_n >= 8 ? 4 : ctl_n / 2;
+        for (long i = 0; i < k; i++) { f += ctl[i]; l += ctl[ctl_n - 1 - i]; }
+        fprintf(stderr, "ds4: head tile from position %d over %ld tokens; control first %ld "
+                "steps %.2f ms, last %ld %.2f ms\n", prompt.len, n, k, k ? f / k : 0.0, k,
+                k ? l / k : 0.0);
+    }
+    for (int arm = 0; arm < ARMS; arm++) {
+        const double r = runs[arm] ? (double)runs[arm] : 1.0;
+        const double f0 = oruns[0][0] ? oms[0][0] / oruns[0][0] : 0.0;
+        const double b0 = oruns[1][0] ? oms[1][0] / oruns[1][0] : 0.0;
+        const double fa = oruns[0][arm] ? oms[0][arm] / oruns[0][arm] : 0.0;
+        const double ba = oruns[1][arm] ? oms[1][arm] / oruns[1][arm] : 0.0;
+        fprintf(stderr, "ds4:   %u head(s) a threadgroup: %.2f ms a step (minus one head %+.2f: "
+                "forward %+.2f, backward %+.2f); %.0f vec threadgroups a step; logits differed "
+                "%ld of %ld; vec partials: %llu layer-compares, %llu differed, %.1f MiB\n",
+                tile[arm], ms[arm] / r, ms[arm] / r - (runs[0] ? ms[0] / runs[0] : 0.0),
+                fa - f0, ba - b0, tgs[arm] / r, differ[arm], arm ? 2 * n : n,
+                chk[arm][0], chk[arm][1], chk[arm][2] / 1048576.0);
+    }
+done:
+    ds4_gpu_attn_cf_mode(0);
+    ds4_gpu_set_attn_head_par(0);
+    if (s) ds4_session_free(s);
+    free(lg); free(ref); free(carry);
 }
 
