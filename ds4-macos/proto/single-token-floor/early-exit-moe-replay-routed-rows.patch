+/* abmoe:<tokens> - the MoE's counterfactual replay in one process: an untimed
+ * pass keeps each layer's routed mid, routed output and shared output, then
+ * the arms leave one part out and read what was kept, forward on even tokens
+ * and backward on odd ones, each arm's logits compared in full with the kept
+ * pass's. The last arm runs everything plus one copy, the price of the copy
+ * the other arms need. */
+static void ds41_moe_rp_multi(ds4_session *seed, const ds4_model *m, const ds4_weights *w,
+                              long n) {
+    enum { WARM = 4, ARMS = 6 };
+    static const int mode[ARMS] = { 0, 2, 3, 4, 5, 6 };
+    static const char *name[ARMS] = {
+        "control (all run)              ", "routed gate/up left out (+copy)",
+        "routed down left out (+copy)   ", "routed both left out (+copy)   ",
+        "shared expert left out (+copy) ", "control plus one copy          " };
+    ds4_engine *e = seed->engine;
+    ds4_tokens prompt = { .v = seed->checkpoint.v, .len = seed->checkpoint.len,
+                          .cap = seed->checkpoint.cap };
+    ds4_session *s = NULL;
+    float *lg = malloc((size_t)DS4_N_VOCAB * sizeof(float));
+    float *ref = malloc((size_t)DS4_N_VOCAB * sizeof(float));
+    float *carry = malloc((size_t)3u * 2u * 512u * sizeof(float));
+    double ms[ARMS] = {0}, oms[2][ARMS] = {{0}}, ctl[512];
+    long runs[ARMS] = {0}, oruns[2][ARMS] = {{0}}, differ[ARMS] = {0}, ctl_n = 0;
+    unsigned long long cnt[ARMS][2] = {{0}};
+    if (!lg || !ref || !carry || n < 1 ||
+        !ds41_txn_prefill(&s, e, &prompt, seed->ctx_size, "moe replay")) goto done;
+    ds41_gpu_graph *g = &s->ds41_graph;
+    int token = sample_argmax(s->logits, DS4_N_VOCAB);
+    for (long t = 0; t < n; t++) {
+        const uint32_t pos0 = g->pos;
+        const ds4_engram_history hist0 = g->history;
+        if (!ds4_gpu_synchronize()) goto done;
+        for (uint32_t ci = 0; ci < 3; ci++)
+            if (!ds4_gpu_tensor_read(g->previous_kv[ci], 0, carry + (size_t)ci * 1024u, 2048u) ||
+                !ds4_gpu_tensor_read(g->previous_score[ci], 0, carry + (size_t)ci * 1024u + 512u, 2048u))
+                goto done;
+        for (int a = -1; a < ARMS; a++) {
+            const int arm = a < 0 ? 0 : (t & 1) ? ARMS - 1 - a : a;
+            g->pos = pos0; g->history = hist0; g->valid = true;
+            (void)ds4_gpu_synchronize();
+            for (uint32_t ci = 0; ci < 3; ci++) {
+                (void)ds4_gpu_tensor_write(g->previous_kv[ci], 0, carry + (size_t)ci * 1024u, 2048u);
+                (void)ds4_gpu_tensor_write(g->previous_score[ci], 0, carry + (size_t)ci * 1024u + 512u, 2048u);
+            }
+            g_ds41_moe_rp = a < 0 ? 1 : mode[arm];
+            const unsigned long long c0 = g_ds41_rp_counts[0], c1 = g_ds41_rp_counts[1];
+            const double t0 = now_sec();
+            const bool ok = ds41_graph_step(g, m, w, token, lg);
+            const double dt = (now_sec() - t0) * 1e3;
+            if (!ok) goto done;
+            if (a < 0) { memcpy(ref, lg, (size_t)DS4_N_VOCAB * sizeof(float)); continue; }
+            if (memcmp(ref, lg, (size_t)DS4_N_VOCAB * sizeof(float)) != 0) differ[arm]++;
+            if (t >= WARM) {
+                ms[arm] += dt; runs[arm]++;
+                oms[t & 1][arm] += dt; oruns[t & 1][arm]++;
+                cnt[arm][0] += g_ds41_rp_counts[0] - c0;
+                cnt[arm][1] += g_ds41_rp_counts[1] - c1;
+                if (arm == 0 && ctl_n < 512) ctl[ctl_n++] = dt;
+            }
+        }
+        g_ds41_moe_rp = 0;
+        token = sample_argmax(lg, DS4_N_VOCAB);
+    }
+    {
+        double f = 0, l = 0;
+        const long k = ctl_n >= 8 ? 4 : ctl_n / 2;
+        for (long i = 0; i < k; i++) { f += ctl[i]; l += ctl[ctl_n - 1 - i]; }
+        fprintf(stderr, "ds4: MoE replay from position %d over %ld tokens; control first %ld "
+                "steps %.2f ms, last %ld %.2f ms\n", prompt.len, n, k, k ? f / k : 0.0, k,
+                k ? l / k : 0.0);
+    }
+    for (int arm = 0; arm < ARMS; arm++) {
+        const double r = runs[arm] ? (double)runs[arm] : 1.0;
+        const double f0 = oruns[0][0] ? oms[0][0] / oruns[0][0] : 0.0;
+        const double b0 = oruns[1][0] ? oms[1][0] / oruns[1][0] : 0.0;
+        const double fa = oruns[0][arm] ? oms[0][arm] / oruns[0][arm] : 0.0;
+        const double ba = oruns[1][arm] ? oms[1][arm] / oruns[1][arm] : 0.0;
+        fprintf(stderr, "ds4:   %s %.2f ms a step (minus control %+.2f: forward %+.2f, "
+                "backward %+.2f); a step %.1f layers replayed, %.1f with nothing kept; "
+                "logits differed %ld of %ld\n", name[arm], ms[arm] / r,
+                ms[arm] / r - (runs[0] ? ms[0] / runs[0] : 0.0), fa - f0, ba - b0,
+                cnt[arm][0] / r, cnt[arm][1] / r, differ[arm], n);
+    }
+done:
+    g_ds41_moe_rp = 0;
+    if (s) ds4_session_free(s);
+    free(lg); free(ref); free(carry);
+}
+
+/* abrows:<tokens> - the routed gate/up and down with 4, 8 or 16 rows to a
+ * simdgroup, in one process. Per token an untimed pass keeps each layer's
+ * routed mid and output with the shipping kernels; one untimed check pass per
+ * arm compares its mid and output with those word by word on the GPU; then
+ * the arms are timed forward on even tokens and backward on odd ones, logits
+ * compared in full with the kept pass's. */
+extern void ds4_gpu_set_routed_rows(uint32_t gate_up, uint32_t down);
+extern void ds4_gpu_dsv41_compare_counts(uint32_t out[16]);
+static void ds41_routed_rows_ab(ds4_session *seed, const ds4_model *m, const ds4_weights *w,
+                                long n) {
+    enum { WARM = 4, ARMS = 6 };
+    static const uint32_t gu[ARMS] = { 0, 8, 16, 0, 8, 16 };
+    static const uint32_t dn[ARMS] = { 0, 0, 0, 8, 8, 16 };
+    ds4_engine *e = seed->engine;
+    ds4_tokens prompt = { .v = seed->checkpoint.v, .len = seed->checkpoint.len,
+                          .cap = seed->checkpoint.cap };
+    ds4_session *s = NULL;
+    float *lg = malloc((size_t)DS4_N_VOCAB * sizeof(float));
+    float *ref = malloc((size_t)DS4_N_VOCAB * sizeof(float));
+    float *carry = malloc((size_t)3u * 2u * 512u * sizeof(float));
+    double ms[ARMS] = {0}, oms[2][ARMS] = {{0}}, ctl[512];
+    long runs[ARMS] = {0}, oruns[2][ARMS] = {{0}}, differ[ARMS] = {0}, ctl_n = 0;
+    unsigned long long wdiff[ARMS][2] = {{0}}, checks[ARMS] = {0};
+    if (!lg || !ref || !carry || n < 1 ||
+        !ds41_txn_prefill(&s, e, &prompt, seed->ctx_size, "routed rows")) goto done;
+    ds41_gpu_graph *g = &s->ds41_graph;
+    int token = sample_argmax(s->logits, DS4_N_VOCAB);
+    for (long t = 0; t < n; t++) {
+        const uint32_t pos0 = g->pos;
+        const ds4_engram_history hist0 = g->history;
+        if (!ds4_gpu_synchronize()) goto done;
+        for (uint32_t ci = 0; ci < 3; ci++)
+            if (!ds4_gpu_tensor_read(g->previous_kv[ci], 0, carry + (size_t)ci * 1024u, 2048u) ||
+                !ds4_gpu_tensor_read(g->previous_score[ci], 0, carry + (size_t)ci * 1024u + 512u, 2048u))
+                goto done;
+        /* -ARMS keeps, -ARMS+1..-1 check arms 1..ARMS-1, then the timed arms */
+        for (int a = -ARMS; a < ARMS; a++) {
+            const bool keep = a == -ARMS, check = a > -ARMS && a < 0;
+            const int arm = keep ? 0 : check ? a + ARMS : (t & 1) ? ARMS - 1 - a : a;
+            g->pos = pos0; g->history = hist0; g->valid = true;
+            (void)ds4_gpu_synchronize();
+            for (uint32_t ci = 0; ci < 3; ci++) {
+                (void)ds4_gpu_tensor_write(g->previous_kv[ci], 0, carry + (size_t)ci * 1024u, 2048u);
+                (void)ds4_gpu_tensor_write(g->previous_score[ci], 0, carry + (size_t)ci * 1024u + 512u, 2048u);
+            }
+            g_ds41_moe_rp = keep ? 1 : check ? 7 : 0;
+            ds4_gpu_set_routed_rows(gu[arm], dn[arm]);
+            uint32_t c0[16], c1[16];
+            ds4_gpu_dsv41_compare_counts(c0);
+            const double t0 = now_sec();
+            const bool ok = ds41_graph_step(g, m, w, token, lg);
+            const double dt = (now_sec() - t0) * 1e3;
+            if (!ok) goto done;
+            if (keep) { memcpy(ref, lg, (size_t)DS4_N_VOCAB * sizeof(float)); continue; }
+            if (memcmp(ref, lg, (size_t)DS4_N_VOCAB * sizeof(float)) != 0) differ[arm]++;
+            if (check) {
+                ds4_gpu_dsv41_compare_counts(c1);
+                wdiff[arm][0] += c1[6] - c0[6];
+                wdiff[arm][1] += c1[7] - c0[7];
+                checks[arm]++;
+                continue;
+            }
+            if (t >= WARM) {
+                ms[arm] += dt; runs[arm]++;
+                oms[t & 1][arm] += dt; oruns[t & 1][arm]++;
+                if (arm == 0 && ctl_n < 512) ctl[ctl_n++] = dt;
+            }
+        }
+        g_ds41_moe_rp = 0;
+        ds4_gpu_set_routed_rows(0, 0);
+        token = sample_argmax(lg, DS4_N_VOCAB);
+    }
+    {
+        double f = 0, l = 0;
+        const long k = ctl_n >= 8 ? 4 : ctl_n / 2;
+        for (long i = 0; i < k; i++) { f += ctl[i]; l += ctl[ctl_n - 1 - i]; }
+        fprintf(stderr, "ds4: routed rows from position %d over %ld tokens; control first %ld "
+                "steps %.2f ms, last %ld %.2f ms\n", prompt.len, n, k, k ? f / k : 0.0, k,
+                k ? l / k : 0.0);
+    }
+    for (int arm = 0; arm < ARMS; arm++) {
+        const double r = runs[arm] ? (double)runs[arm] : 1.0;
+        const double f0 = oruns[0][0] ? oms[0][0] / oruns[0][0] : 0.0;
+        const double b0 = oruns[1][0] ? oms[1][0] / oruns[1][0] : 0.0;
+        const double fa = oruns[0][arm] ? oms[0][arm] / oruns[0][arm] : 0.0;
+        const double ba = oruns[1][arm] ? oms[1][arm] / oruns[1][arm] : 0.0;
+        fprintf(stderr, "ds4:   gate/up %2u rows, down %2u rows: %.2f ms a step (minus control "
+                "%+.2f: forward %+.2f, backward %+.2f); logits differed %ld of %ld; check "
+                "passes %llu, mid words differing %llu, output words differing %llu\n",
+                gu[arm] ? gu[arm] : 4u, dn[arm] ? dn[arm] : 4u, ms[arm] / r,
+                ms[arm] / r - (runs[0] ? ms[0] / runs[0] : 0.0), fa - f0, ba - b0,
+                differ[arm], arm ? 2 * n : n, checks[arm], wdiff[arm][0], wdiff[arm][1]);
+    }
+done:
+    g_ds41_moe_rp = 0;
+    ds4_gpu_set_routed_rows(0, 0);
+    if (s) ds4_session_free(s);
+    free(lg); free(ref); free(carry);
+}
