     if (env && !strncmp(env, "abenc:", 6)) {
         g_ds41_ab_encoder = 1;
         ds41_router_ab(s, m, w, atol(env + 6), true);
diff --git a/ds4_metal.m b/ds4_metal.m
index 32983b8..84193f7 100644
--- a/ds4_metal.m
+++ b/ds4_metal.m
@@ -44833,6 +44833,12 @@ int ds4_gpu_gate_active_for_layer(uint32_t il) {
  * So: two masked passes over the live table and nothing else. No service
  * thread, no shared event, no repair pass, no snapshot.
  */
+static uint32_t g_routed_nr_gu, g_routed_nr_dn;
+void ds4_gpu_set_routed_rows(uint32_t gate_up, uint32_t down) {
