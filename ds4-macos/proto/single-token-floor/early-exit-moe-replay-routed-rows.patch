+/* DS4_METAL_V41_GATE_TRACE=x:<l1,l2,...> - early exit, measured: after each
+ * listed layer (1-based count of layers done), the head is applied to the
+ * residual as it stands and its argmax kept; at the end of the step each is
+ * compared with the step's own argmax. How often a shallow stack names the
+ * same next token is the most a self-draft from that depth could accept.
+ * The step drains at each probe, so this is a measurement, not a path. */
+static uint32_t g_exit_layers[8], g_exit_n = 0xffffffffu;
+static int g_exit_pred[8];
+static unsigned long long g_exit_same[8], g_exit_steps;
+static void ds41_exit_parse(void) {
+    if (g_exit_n != 0xffffffffu) return;
+    g_exit_n = 0;
+    const char *e = getenv("DS4_METAL_V41_GATE_TRACE");
+    if (!e || strncmp(e, "x:", 2)) return;
+    for (const char *p = e + 2; *p && g_exit_n < 8; ) {
+        g_exit_layers[g_exit_n++] = (uint32_t)strtoul(p, (char **)&p, 10);
+        if (*p == ',') p++; else break;
+    }
+}
 static bool ds41_graph_step_inner(ds41_gpu_graph *g, const ds4_model *m,
                                   const ds4_weights *w, int token, float *logits);
 
