+/* DS4_METAL_V41_HC_COMPOUND=2: the MoE's tail as one dispatch. The shared
+ * expert's deferred rounding and the finish (routed + shared, BF16) are not
+ * issued; the expand after the MoE computes them in place of reading the
+ * block (kernel_dsv41_moe_finish_expand4_pre). Single-step graph only, and
+ * only where that expand is the fused one. */
+static struct { bool pending, late3; } g_ds41_tail;
+/* =3 also runs the separate tail into shadows and counts differing words in
+ * the transition compare's residual and pre slots (4, 5). */
+static int g_ds41_tail_level;
+static unsigned long long g_ds41_tail_fused, g_ds41_tail_rounds_folded;
+static bool ds41_moe_tail_on(const ds41_gpu_graph *g) {
+    static int checked, on;
+    if (!checked) {
+        const char *e = getenv("DS4_METAL_V41_HC_COMPOUND");
+        checked = 1;
+        on = e ? atoi(e) : 0;
+        on = on == 2 || on == 3 ? on : 0;
+    }
+    g_ds41_tail_level = on;
+    return on && g && g == g_ds41_dag_graph && g->tp_world != 2 &&
+           g_ds41_sabl_stage == 0 && !g_ds41_sabl_capture &&
+           ds41_fuse_bf16() && ds41_fuse_transition() == 2;
+}
