<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for ds4-server (DwarfStar local inference HTTP API) on macOS/Metal.

  install.sh substitutes the __UPPERCASE__ tokens (__PREFIX__, __WORKDIR__,
  __LOGDIR__, and the __DS4_SERVER_ARGS__ and __DS4_SERVER_ENV__ lines) and
  writes the result to ~/Library/LaunchAgents/com.antirez.ds4-server.plist.
  Runtime settings live in ds4-server.env: DS4_SERVER_ARGS is expanded into the
  ProgramArguments array below, because launchd does NOT word-split env vars the
  way systemd's ExecStart does, and each KEY=VALUE of DS4_SERVER_ENV becomes an
  entry of EnvironmentVariables.

  This is a LaunchAgent (per-user, login session), not a LaunchDaemon: ds4-server
  uses Metal, which requires a logged-in GUI session. A boot-time daemon cannot
  reach the GPU.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.antirez.ds4-server</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PREFIX__/ds4-server</string>
__DS4_SERVER_ARGS__
    </array>

    <!-- The engine's switches (DS4_SERVER_ENV). V4.1 production is defined by
         these as much as by its flags. -->
    <key>EnvironmentVariables</key>
    <dict>
__DS4_SERVER_ENV__
    </dict>

    <!-- Resolve relative model/MTP paths against the model directory. -->
    <key>WorkingDirectory</key>
    <string>__WORKDIR__</string>

    <!-- On-demand, NOT at login. This agent plans ~78 GiB for DeepSeek V4.1
         Flash and launchd has no systemd `Conflicts=`, so starting it at login
         reserves most of a 128 GB machine against whatever else is resident.
         Start it when you want it:
             launchctl kickstart gui/$(id -u)/com.antirez.ds4-server

         RunAtLoad=false alone is not enough: launchd.plist(5) says any
         KeepAlive "implicitly implies RunAtLoad", and SuccessfulExit in
         particular "implies that RunAtLoad is set to true". With
         KeepAlive{SuccessfulExit=false} this agent was started at every load
         (login, or install.sh's bootstrap) despite the false below. V4.1 prewarms ~58 GiB of experts at startup, so it no
         longer idles at ~5 MB. Hence no KeepAlive (and no ThrottleInterval,
         which only paces relaunches): a crash leaves it down until started. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Model load is slow; give a generous graceful-shutdown window (SIGTERM
         then SIGKILL after this many seconds). -->
    <key>ExitTimeOut</key>
    <integer>120</integer>

    <key>StandardOutPath</key>
    <string>__LOGDIR__/ds4-server.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGDIR__/ds4-server.err.log</string>

    <!-- Keep the GPU duty cycle at foreground priority. -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
