# Runtime settings for ds4-server on macOS (Metal): DeepSeek V4.1 Flash Q2.
#
# install.sh reads DS4_SERVER_ENV and DS4_SERVER_ARGS, renders them into the
# LaunchAgent plist (EnvironmentVariables and ProgramArguments), and installs
# the result. To change them later: edit this file (or the copy install.sh
# made), then re-run ./install.sh — it rewrites the plist and reloads the agent.
#
# These are the launch settings of the exact V4.1 Metal 4 production, tag
# ds4-v41-metal4-superbatch-exact-production-documented on ngc-shj/ds4. It was
# measured with every variable below set and with --ctx 8192; change none of
# them unless you intend to re-measure. The tag's README says what each one does.
#
# host 127.0.0.1 keeps the API local-only. 0.0.0.0 exposes it on the LAN; the
# server has NO auth, so firewall the port and only do this on a trusted network.
#
# Paths: -m is relative to WORKDIR (the checkout root); download_model.sh writes
# the GGUF into gguf/. An absolute path works too, if the 341 GiB file lives in
# another checkout.
#
# Memory: STREAMING_MEMORY_BUDGET_GIB=80 fits everything the engine allocates
# (KV, buffers, 9.37 GiB resident weights, expert cache, prefill reserve) into
# 80 GiB. --ssd-streaming-cache-experts 10268 is a request; the budget fits the
# cache to about 7034 experts and the startup log says so, planning 77.99 GiB.
# The rest of 128 GB is left to macOS — not to a second engine.

DS4_SERVER_ENV="DS4_METAL_V41_MTL4=1 DS4_METAL_V41_STREAMING_MEMORY_BUDGET_GIB=80 DS4_METAL_V41_DECODE_QUEUE=1 DS4_METAL_V41_DECODE_LEND_HEADROOM=2 DS4_METAL_IQ2_SELECTED_SHARED_EVENT=1 DS4_METAL_STREAM_SPLIT_MIN_MISSING=1 DS4_METAL_STREAMING_EXPERT_AUTO_PRELOAD_CAP=8192 DS4_METAL_V41_ABORT_GATE=40 DS4_METAL_V41_ABORT_GATE_SEG=3 DS4_METAL_V41_EXPERT_RESIDENCY_SET=1 DS4_METAL_V41_FFN_OVERLAP=1 DS4_METAL_V41_ROUTER_FUSE_TRANSFORM=5 DS4_METAL_V41_FUSE_BF16=2 DS4_METAL_V41_HC_COMPOUND=1 DS4_METAL_V41_GATE_ENCODE_AHEAD=1"

DS4_SERVER_ARGS="-m gguf/DeepSeek-V4.1-Flash-Q2.gguf --ssd-streaming --ctx 8192 --ssd-streaming-cache-experts 10268 --host 127.0.0.1 --port 8000"

# The production was measured without --kv-disk-dir; install.sh still creates
# __KVDIR__ if you want to add it (--kv-disk-dir __KVDIR__ --kv-disk-space-mb 8192).
# It was also measured without MTP. The V4 MTP draft does not carry over: V4.1
# is a different architecture with its own GGUF (see EVALUATIONS.md, 2026-09-15).
