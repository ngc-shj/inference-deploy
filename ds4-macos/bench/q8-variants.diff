diff --git a/metal/dense.metal b/metal/dense.metal
index 44b7682..a9da408 100644
--- a/metal/dense.metal
+++ b/metal/dense.metal
@@ -368,6 +368,752 @@ kernel void kernel_mul_mv_q8_0_f32_rows4_nr8(
     kernel_mul_mv_q8_0_f32_rows_impl<8, 4, constant ds4_metal_args_mul_mv &>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg);
