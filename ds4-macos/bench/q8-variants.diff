+
+template<short NR0, short BR, typename args_t, bool DST_GROUPED = false>
+void kernel_mul_mv_q8_0_f32_rows_rd_impl(
+        args_t args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem,
+        uint3  tgpig,
+        ushort tiisg,
+        ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg;
+
+    constexpr short NW = N_SIMDWIDTH;
+    constexpr short NQ = 8;
+
+    const int nb = args.ne00/QK8_0;
+
+    const int r0 = tgpig.x*NR0;
+    const int rb = tgpig.y*BR;
+    const int im = tgpig.z;
+
+    const uint i12 = im%args.ne12;
+    const uint i13 = im/args.ne12;
+
+    // A tile past the last row reads the last row's activations and stores
+    // nothing, which keeps the inner loop free of per-row branches.
+    device const float * y[BR];
+    FOR_UNROLL (short b = 0; b < BR; ++b) {
+        const int r1 = rb + b < args.ne1 ? rb + b : args.ne1 - 1;
+        const uint64_t offset1 = r1*args.nb11 + (i12)*args.nb12 + (i13)*args.nb13;
+        y[b] = (device const float *) (src1 + offset1);
+    }
+
+    // An output row past the last one reads the last row's weights and its
+    // result is never stored (the reduction writes only r0 + row < ne01), so
+    // a last group of fewer than NR0 rows reads nothing outside the matrix
+    // and every stored row is computed exactly as before.
+    device const block_q8_0 * ax[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const int orow = r0 + row < args.ne01 ? r0 + row : args.ne01 - 1;
+        const uint64_t offset0 = (uint64_t)orow*args.nb01 + (i12/args.r2)*args.nb02 + (i13/args.r3)*args.nb03;
+
+        ax[row] = (device const block_q8_0 *) ((device char *) src0 + offset0);
+    }
+
+    float sumf[BR][NR0];
+    FOR_UNROLL (short b = 0; b < BR; ++b) {
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            sumf[b][row] = 0.f;
+        }
+    }
+
+    const short ix = tiisg/(NW/NQ);
+    const short il = tiisg%(NW/NQ);
+
+    const int ib0 = sgitg*NQ + ix;
+
+    float yl[BR][NQ];
+
+    device const float * yb[BR];
+    FOR_UNROLL (short b = 0; b < BR; ++b) {
+        yb[b] = y[b] + ib0*QK8_0 + il*NQ;
+    }
+
+    for (int ib = ib0; ib < nb; ib += NSG*NQ) {
+        FOR_UNROLL (short b = 0; b < BR; ++b) {
+            for (short i = 0; i < NQ; ++i) {
+                yl[b][i] = yb[b][i];
+            }
+        }
+
+        for (short row = 0; row < NR0; row++) {
+            device const int8_t * qs = ax[row][ib].qs + il*NQ;
+
+            /* Read the block's quants and its scale into registers before the
+             * batch loop. Hoisting only the pointer would leave the device
+             * loads inside it and rely on the compiler to notice they are
+             * invariant; the whole point of this kernel is that the weight is
+             * read once for BR rows, so the source has to say it. */
+            int8_t qv[NQ];
+            FOR_UNROLL (short i = 0; i < NQ; ++i) {
+                qv[i] = qs[i];
+            }
+            const float d = ax[row][ib].d;
+
+            FOR_UNROLL (short b = 0; b < BR; ++b) {
+                float sumq = 0.f;
+                FOR_UNROLL (short i = 0; i < NQ; ++i) {
+                    sumq += qv[i] * yl[b][i];
+                }
+
+                sumf[b][row] += sumq*d;
+            }
+        }
+
+        FOR_UNROLL (short b = 0; b < BR; ++b) {
+            yb[b] += NSG*NQ*QK8_0;
+        }
+    }
+
+    // Every (row, output) reduced at once: the same simd_sum of each lane's
+    // sum, the same per-simdgroup slots summed by the same simd_sum - the
+    // helper's tree - with two barriers for the tile instead of two a row,
+    // and the final sums spread over the simdgroups.
+    threadgroup float * sh = (threadgroup float *) shmem;
+    FOR_UNROLL (short b = 0; b < BR; ++b) {
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            if (sgitg == 0) sh[(b*NR0 + row)*NW + tiisg] = 0.0f;
+            sumf[b][row] = simd_sum(sumf[b][row]);
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    FOR_UNROLL (short b = 0; b < BR; ++b) {
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            if (tiisg == 0) sh[(b*NR0 + row)*NW + sgitg] = sumf[b][row];
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (short k = sgitg; k < BR*NR0; k += NSG) {
+        const short b = k / NR0, row = k % NR0;
+        const float tot = simd_sum(sh[k*NW + tiisg]);
+        if (tiisg == 0 && rb + b < args.ne1 && r0 + row < args.ne01) {
+            device float * dst_f32 = (device float *) dst +
+                (DST_GROUPED
+                     ? (uint64_t)(rb + b)*args.ne0*args.ne02 + (uint64_t)im*args.ne0
+                     : (uint64_t)im*args.ne0*args.ne1 + (uint64_t)(rb + b)*args.ne0);
+            dst_f32[r0 + row] = args.round_bf16 ? ds4_round_bf16(tot) : tot;
+        }
+    }
+}
