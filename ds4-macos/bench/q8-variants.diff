+// The four-row tile with G groups of NR0 output rows a threadgroup, sharing
+// one staging of the four rows' activations in threadgroup memory.
+//
+// In kernel_mul_mv_q8_0_f32_rows_impl every threadgroup loads the activations
+// for its own NR0 outputs, so a 699-row step reads them outputs / NR0 times -
+// twice the bytes of the weight it shares across four rows. Here the G groups
+// of a threadgroup are each that kernel's NSG simdgroups for NR0 outputs, with
+// the same ix / il / ib0 K walk and stride, the same i order inside a block,
+// the same sumq * d into the same accumulator and their own reduction scratch,
+// so an output is computed exactly as there. Only where a lane reads its
+// activation from changes: each K step, all G groups' threads copy the four
+// rows' NSG * NQ blocks into threadgroup memory together and read them back.
+template<short NR0, short BR, short G, typename args_t>
+void kernel_mul_mv_q8_0_f32_rows_shared_impl(
+        args_t args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem,
+        uint3  tgpig,
+        ushort tiisg,
+        ushort sgall) {
+    const short NSG = FC_mul_mv_nsg;
+
+    constexpr short NW = N_SIMDWIDTH;
+    constexpr short NQ = 8;
+
+    const short sgitg = sgall % NSG;
+    const short grp   = sgall / NSG;
+
+    const int nb = args.ne00/QK8_0;
+    const int span = NSG*NQ*QK8_0;   // activation floats a K step covers
+
+    const int r0 = (tgpig.x*G + grp)*NR0;
+    const int rb = tgpig.y*BR;
+    const int im = tgpig.z;
+
+    const uint i12 = im%args.ne12;
+    const uint i13 = im/args.ne12;
+
+    device const float * y[BR];
+    FOR_UNROLL (short b = 0; b < BR; ++b) {
+        const int r1 = rb + b < args.ne1 ? rb + b : args.ne1 - 1;
+        const uint64_t offset1 = r1*args.nb11 + (i12)*args.nb12 + (i13)*args.nb13;
+        y[b] = (device const float *) (src1 + offset1);
+    }
+
+    device const block_q8_0 * ax[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const int orow = r0 + row < args.ne01 ? r0 + row : args.ne01 - 1;
+        const uint64_t offset0 = (uint64_t)orow*args.nb01 + (i12/args.r2)*args.nb02 + (i13/args.r3)*args.nb03;
+
+        ax[row] = (device const block_q8_0 *) ((device char *) src0 + offset0);
+    }
+
+    // The reduction scratch of the G groups, then the staged activations.
+    threadgroup char  * red = shmem + (uint64_t)grp*NW*NR0*sizeof(float);
+    threadgroup float * ys  = (threadgroup float *) (shmem + (uint64_t)G*NW*NR0*sizeof(float));
+
+    float sumf[BR][NR0];
+    FOR_UNROLL (short b = 0; b < BR; ++b) {
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            sumf[b][row] = 0.f;
+        }
+    }
+
+    const short ix = tiisg/(NW/NQ);
+    const short il = tiisg%(NW/NQ);
+
+    const int ib0 = sgitg*NQ + ix;
+    const int lane_off = ib0*QK8_0 + il*NQ;    // within a K step
+    const int tid = sgall*NW + tiisg;
+    const int nthreads = NSG*G*NW;
+
+    float yl[BR][NQ];
+
+    for (int base = 0; base < nb; base += NSG*NQ) {
+        const int k0 = base*QK8_0;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (int t = tid; t < BR*span; t += nthreads) {
+            const int b = t / span, k = t % span;
+            ys[t] = k0 + k < args.ne00 ? y[b][k0 + k] : 0.f;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        const int ib = base + ib0;
+        if (ib < nb) {
+            FOR_UNROLL (short b = 0; b < BR; ++b) {
+                for (short i = 0; i < NQ; ++i) {
+                    yl[b][i] = ys[b*span + lane_off + i];
+                }
+            }
+
+            for (short row = 0; row < NR0; row++) {
+                device const int8_t * qs = ax[row][ib].qs + il*NQ;
+
+                int8_t qv[NQ];
+                FOR_UNROLL (short i = 0; i < NQ; ++i) {
+                    qv[i] = qs[i];
+                }
+                const float d = ax[row][ib].d;
+
+                FOR_UNROLL (short b = 0; b < BR; ++b) {
+                    float sumq = 0.f;
+                    FOR_UNROLL (short i = 0; i < NQ; ++i) {
+                        sumq += qv[i] * yl[b][i];
+                    }
+
+                    sumf[b][row] += sumq*d;
+                }
+            }
+        }
+    }
+
+    for (short b = 0; b < BR; ++b) {
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        device float * dst_f32 = (device float *) dst +
+            (uint64_t)im*args.ne0*args.ne1 + (uint64_t)(rb + b)*args.ne0;
+
+        float sv[NR0];
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            sv[row] = sumf[b][row];
+        }
+
+        // Every thread takes part in the helper's barriers; a row past the
+        // last one, or an output group past the matrix, stores nothing.
+        helper_mv_reduce_and_write<NR0>(dst_f32, sv,
+            rb + b < args.ne1 ? r0 : args.ne01, args.ne01, tiisg, sgitg, red, args.round_bf16);
+    }
+}
+
+// kernel_mul_mv_q8_0_f32_rows_impl with each lane's quants converted to float
+// once per output row rather than once per (row, batch row): the conversion of
+// an int8 to float is exact, so every product is the same product.
+template<short NR0, short BR, typename args_t>
+void kernel_mul_mv_q8_0_f32_rows_qf_impl(
+        args_t args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem,
+        uint3  tgpig,
+        ushort tiisg,
+        ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg;
+
+    constexpr short NW = N_SIMDWIDTH;
+    constexpr short NQ = 8;
+
+    const int nb = args.ne00/QK8_0;
+
+    const int r0 = tgpig.x*NR0;
+    const int rb = tgpig.y*BR;
+    const int im = tgpig.z;
+
+    const uint i12 = im%args.ne12;
+    const uint i13 = im/args.ne12;
+
+    device const float * y[BR];
+    FOR_UNROLL (short b = 0; b < BR; ++b) {
+        const int r1 = rb + b < args.ne1 ? rb + b : args.ne1 - 1;
+        const uint64_t offset1 = r1*args.nb11 + (i12)*args.nb12 + (i13)*args.nb13;
+        y[b] = (device const float *) (src1 + offset1);
+    }
+
+    device const block_q8_0 * ax0;
+    {
+        const uint64_t offset0 = (uint64_t)r0*args.nb01 + (i12/args.r2)*args.nb02 + (i13/args.r3)*args.nb03;
+        ax0 = (device const block_q8_0 *) ((device char *) src0 + offset0);
+    }
+    const int nrows_here = args.ne01 - r0 < NR0 ? args.ne01 - r0 : NR0;
+    const int bstride = args.nb01 / sizeof(block_q8_0);
+
+    float sumf[BR][NR0];
+    FOR_UNROLL (short b = 0; b < BR; ++b) {
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            sumf[b][row] = 0.f;
+        }
+    }
+
+    const short ix = tiisg/(NW/NQ);
+    const short il = tiisg%(NW/NQ);
+
+    const int ib0 = sgitg*NQ + ix;
+
+    float yl[BR][NQ];
+
+    device const float * yb[BR];
+    FOR_UNROLL (short b = 0; b < BR; ++b) {
+        yb[b] = y[b] + ib0*QK8_0 + il*NQ;
+    }
+
+    for (int ib = ib0; ib < nb; ib += NSG*NQ) {
+        FOR_UNROLL (short b = 0; b < BR; ++b) {
+            for (short i = 0; i < NQ; ++i) {
+                yl[b][i] = yb[b][i];
+            }
+        }
+
+        FOR_UNROLL (short row = 0; row < NR0; row++) {
+            const short orow = row < nrows_here ? row : nrows_here - 1;
+            device const block_q8_0 * blk = ax0 + (uint64_t)orow*bstride + ib;
+            device const int8_t * qs = blk->qs + il*NQ;
+
+            float qf[NQ];
+            FOR_UNROLL (short i = 0; i < NQ; ++i) {
+                qf[i] = (float) qs[i];
+            }
+            const float d = blk->d;
+
+            FOR_UNROLL (short b = 0; b < BR; ++b) {
+                float sumq = 0.f;
+                FOR_UNROLL (short i = 0; i < NQ; ++i) {
+                    sumq += qf[i] * yl[b][i];
+                }
+
+                sumf[b][row] += sumq*d;
+            }
+        }
+
+        FOR_UNROLL (short b = 0; b < BR; ++b) {
+            yb[b] += NSG*NQ*QK8_0;
+        }
+    }
+
+    for (short b = 0; b < BR; ++b) {
+        if (rb + b < args.ne1) {
+            device float * dst_f32 = (device float *) dst +
+                (uint64_t)im*args.ne0*args.ne1 + (uint64_t)(rb + b)*args.ne0;
+
+            float s[NR0];
+            FOR_UNROLL (short row = 0; row < NR0; ++row) {
+                s[row] = sumf[b][row];
+            }
+
+            helper_mv_reduce_and_write<NR0>(dst_f32, s, r0, args.ne01, tiisg, sgitg, shmem, args.round_bf16);
+        }
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+}
+
+#define DS4_Q8_QF(NR, BRW) \
+[[host_name("kernel_mul_mv_q8_0_f32_r" #NR "_b" #BRW "_qf")]] \
+kernel void kernel_mul_mv_q8_0_f32_r##NR##_b##BRW##_qf( \
+        constant ds4_metal_args_mul_mv & args, \
+        device const char * src0, \
+        device const char * src1, \
+        device       char * dst, \
+        threadgroup  char * shmem [[threadgroup(0)]], \
+        uint3  tgpig[[threadgroup_position_in_grid]], \
+        ushort tiisg[[thread_index_in_simdgroup]], \
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) { \
+    kernel_mul_mv_q8_0_f32_rows_qf_impl<NR, BRW, constant ds4_metal_args_mul_mv &>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg); \
+}
+DS4_Q8_QF(8, 4)
+DS4_Q8_QF(16, 4)
+DS4_Q8_QF(8, 8)
+#undef DS4_Q8_QF
+
+template<short NR0, short BR, typename args_t, bool DST_GROUPED = false>
+void kernel_mul_mv_q8_0_f32_rows_vl_impl(
+        args_t args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem,
+        uint3  tgpig,
+        ushort tiisg,
+        ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg;
+
+    constexpr short NW = N_SIMDWIDTH;
+    constexpr short NQ = 8;
+
+    const int nb = args.ne00/QK8_0;
+
+    const int r0 = tgpig.x*NR0;
+    const int rb = tgpig.y*BR;
+    const int im = tgpig.z;
+
+    const uint i12 = im%args.ne12;
+    const uint i13 = im/args.ne12;
+
+    // A tile past the last row reads the last row's activations and stores
+    // nothing, which keeps the inner loop free of per-row branches.
+    device const float * y[BR];
+    FOR_UNROLL (short b = 0; b < BR; ++b) {
+        const int r1 = rb + b < args.ne1 ? rb + b : args.ne1 - 1;
+        const uint64_t offset1 = r1*args.nb11 + (i12)*args.nb12 + (i13)*args.nb13;
+        y[b] = (device const float *) (src1 + offset1);
+    }
+
+    // An output row past the last one reads the last row's weights and its
+    // result is never stored (the reduction writes only r0 + row < ne01), so
+    // a last group of fewer than NR0 rows reads nothing outside the matrix
+    // and every stored row is computed exactly as before.
+    device const block_q8_0 * ax[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const int orow = r0 + row < args.ne01 ? r0 + row : args.ne01 - 1;
+        const uint64_t offset0 = (uint64_t)orow*args.nb01 + (i12/args.r2)*args.nb02 + (i13/args.r3)*args.nb03;
+
+        ax[row] = (device const block_q8_0 *) ((device char *) src0 + offset0);
+    }
+
+    float sumf[BR][NR0];
+    FOR_UNROLL (short b = 0; b < BR; ++b) {
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            sumf[b][row] = 0.f;
+        }
+    }
+
+    const short ix = tiisg/(NW/NQ);
+    const short il = tiisg%(NW/NQ);
+
+    const int ib0 = sgitg*NQ + ix;
+
+    float yl[BR][NQ];
+
+    device const float * yb[BR];
+    FOR_UNROLL (short b = 0; b < BR; ++b) {
+        yb[b] = y[b] + ib0*QK8_0 + il*NQ;
+    }
+
+    for (int ib = ib0; ib < nb; ib += NSG*NQ) {
+        FOR_UNROLL (short b = 0; b < BR; ++b) {
+            const float4 ya = *(device const float4 *)(yb[b]);
+            const float4 yc = *(device const float4 *)(yb[b] + 4);
+            yl[b][0] = ya.x; yl[b][1] = ya.y; yl[b][2] = ya.z; yl[b][3] = ya.w;
+            yl[b][4] = yc.x; yl[b][5] = yc.y; yl[b][6] = yc.z; yl[b][7] = yc.w;
+        }
+
+        for (short row = 0; row < NR0; row++) {
+            device const int8_t * qs = ax[row][ib].qs + il*NQ;
+
+            /* Read the block's quants and its scale into registers before the
+             * batch loop. Hoisting only the pointer would leave the device
+             * loads inside it and rely on the compiler to notice they are
+             * invariant; the whole point of this kernel is that the weight is
+             * read once for BR rows, so the source has to say it. */
+            const char4 qa = char4(*(device const packed_char4 *)(qs));
+            const char4 qc = char4(*(device const packed_char4 *)(qs + 4));
+            const int8_t qv[NQ] = { qa.x, qa.y, qa.z, qa.w, qc.x, qc.y, qc.z, qc.w };
+            const float d = ax[row][ib].d;
+
+            FOR_UNROLL (short b = 0; b < BR; ++b) {
+                float sumq = 0.f;
+                FOR_UNROLL (short i = 0; i < NQ; ++i) {
+                    sumq += qv[i] * yl[b][i];
+                }
+
+                sumf[b][row] += sumq*d;
+            }
+        }
+
+        FOR_UNROLL (short b = 0; b < BR; ++b) {
+            yb[b] += NSG*NQ*QK8_0;
+        }
+    }
+
+    for (short b = 0; b < BR; ++b) {
+        if (rb + b < args.ne1) {
+            device float * dst_f32 = (device float *) dst +
+                (DST_GROUPED
+                     ? (uint64_t)(rb + b)*args.ne0*args.ne02 + (uint64_t)im*args.ne0
+                     : (uint64_t)im*args.ne0*args.ne1 + (uint64_t)(rb + b)*args.ne0);
+
+            float s[NR0];
+            FOR_UNROLL (short row = 0; row < NR0; ++row) {
+                s[row] = sumf[b][row];
+            }
+
+            helper_mv_reduce_and_write<NR0>(dst_f32, s, r0, args.ne01, tiisg, sgitg, shmem, args.round_bf16);
+        }
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+}
