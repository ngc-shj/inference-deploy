+// The four-row tile over RB consecutive row blocks a threadgroup, one after
+// another, each through kernel_mul_mv_q8_0_f32_rows_impl unchanged: a 2048-row
+// step is otherwise a threadgroup for every four rows of every NR0 outputs,
+// each paying its setup and reduction for two K steps on a narrow matrix. The
+// later blocks read the same weight rows the first just did.
+template<short NR0, short BR, short RB, typename args_t>
+void kernel_mul_mv_q8_0_f32_rows_loop_impl(
+        args_t args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem,
+        uint3  tgpig,
+        ushort tiisg,
+        ushort sgitg) {
+    for (short k = 0; k < RB; ++k) {
+        const uint by = tgpig.y*RB + k;
+        if ((int)(by*BR) >= args.ne1) break;
+        kernel_mul_mv_q8_0_f32_rows_impl<NR0, BR, args_t>(args, src0, src1, dst, shmem,
+            uint3(tgpig.x, by, tgpig.z), tiisg, sgitg);
+    }
+}
