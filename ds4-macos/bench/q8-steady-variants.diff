+kernel void kernel_q8_0_prepack40(
+        constant uint & n,
+        device const block_q8_0 * src,
+        device char * dst,
+        uint i [[thread_position_in_grid]]) {
+    if (i >= n) return;
+    device const ushort * qh = (device const ushort *) src[i].qs;
+    uint w[8];
+    for (int k = 0; k < 8; k++) w[k] = (uint)qh[2*k] | ((uint)qh[2*k + 1] << 16);
+    device uint2 * o = (device uint2 *) (dst + (uint64_t)i*40);
+    o[0] = uint2(as_type<ushort>(src[i].d), 0);
+    o[1] = uint2(w[0], w[1]); o[2] = uint2(w[2], w[3]);
+    o[3] = uint2(w[4], w[5]); o[4] = uint2(w[6], w[7]);
+}
