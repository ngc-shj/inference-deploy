+// One Q8_0 matrix's blocks into the prepacked form above: the quants of block
+// i at 32*i, its scale at 32*n + 2*i.
+kernel void kernel_q8_0_prepack(
+        constant uint & n,
+        device const block_q8_0 * src,
+        device char * dst,
+        uint i [[thread_position_in_grid]]) {
+    if (i >= n) return;
+    device uint4 * o = (device uint4 *) (dst + (uint64_t)i*QK8_0);
+    device const ushort * qh = (device const ushort *) src[i].qs;
+    uint w[8];
+    for (int k = 0; k < 8; k++) w[k] = (uint)qh[2*k] | ((uint)qh[2*k + 1] << 16);
+    o[0] = uint4(w[0], w[1], w[2], w[3]);
+    o[1] = uint4(w[4], w[5], w[6], w[7]);
+    ((device half *) (dst + (uint64_t)n*QK8_0))[i] = src[i].d;
+}
