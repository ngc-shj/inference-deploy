+// kernel_mul_mm_id_mpp_packed for gate and up at once: one threadgroup, one
+// activation tile a K step for both. Each matrix keeps its own accumulator,
+// fed by the same matmul2d descriptor over the same K steps in the same order
+// as its own dispatch would, and each output lands where that dispatch puts
+// it, so gate and up are the two dispatches' words.
+//
+// With SWIGLU the epilogue is kernel_dsv4_moe_swiglu_weight(_f16) instead of
+// the two stores: each (row, output) takes its gate and up words as those
+// stores would have left them and the same clamp, SiLU, product and route
+// weight, in the same order, into mid - dst_gate - and nothing else is
+// written.
+template<typename block_q, short nl,
+         void (*dequantize_func)(device const block_q *, short, thread half4x4 &),
+         bool SWIGLU, bool MID_F16, int TileM = 64, int TileN = 32>
+kernel void kernel_mul_mm_id_mpp_packed_pair(
+        constant ds4_metal_args_mul_mm_id &args,
+        device const char *src0_gate,
+        device const char *src0_up,
+        device const half *src1,
+        device const uint *counts,
+        device const int *ids,
+        device float *dst_gate,
+        device float *dst_up,
+        device const uint *work,
+        constant ds4_metal_dsv4_moe_swiglu_weight_args &act,
+        threadgroup char *shmem [[threadgroup(0)]],
+        uint2 group [[threadgroup_position_in_grid]],
+        ushort tid [[thread_index_in_threadgroup]]) {
+    constexpr int M = TileM, N = TileN, K = 32;
+    if (group.x >= work[0]) return;
+    const uint2 item = ((device const uint2 *)(work + 2))[group.x];
+    if (item.y % N) return;
+    const int expert = item.x, r0 = group.y*M, r1 = item.y;
+    const int nr0 = min(M, args.ne0 - r0);
+    const int nr1 = min(N, (int)counts[expert] - r1);
+    if (nr0 <= 0 || nr1 <= 0) return;
+    if (!ds4_tp_owns_expert(expert, args.ne02, args.tp_rank, args.tp_world)) {
+        for (int i = tid; i < nr1*nr0; i += 128) {
+            const int id = ids[expert*args.ne21 + r1 + i/nr0];
+            const uint64_t row = (uint64_t)(id/args.ne20)*args.ne1 + (id%args.ne20);
+            const uint64_t at = row*args.ne0 + r0 + i%nr0;
+            if (!SWIGLU) {
+                dst_gate[at] = 0;
+                dst_up[at] = 0;
+            } else if (MID_F16) {
+                ((device half *)((device char *)dst_gate + row * act.mid_row_stride))[r0 + i%nr0] = 0;
+            } else {
+                ((device float *)((device char *)dst_gate + row * act.mid_row_stride))[r0 + i%nr0] = 0;
+            }
+        }
+        return;
+    }
+
+    threadgroup half *sg = (threadgroup half *)shmem;
+    threadgroup half *su = sg + 2*M*K;
+    auto tG0 = tensor(sg, dextents<int32_t, 2>(K, M));
+    auto tG1 = tensor(sg + M*K, dextents<int32_t, 2>(K, M));
+    auto tU0 = tensor(su, dextents<int32_t, 2>(K, M));
+    auto tU1 = tensor(su + M*K, dextents<int32_t, 2>(K, M));
+    device const uint *offsets = (device const uint *)src1;
+    device half *rhs = (device half *)(offsets + ((args.ne02 + 31u) & ~31u));
+    auto tB = tensor(rhs + (uint64_t)(offsets[expert] + r1)*args.ne00,
+                     dextents<int32_t, 2>(args.ne00, nr1));
+    matmul2d<matmul2d_descriptor(N, M, K, false, true, false,
+                                matmul2d_descriptor::mode::multiply_accumulate),
+             execution_simdgroups<4>> mm;
+    auto acc_g = mm.template get_destination_cooperative_tensor<decltype(tB), decltype(tG0), float>();
+    auto acc_u = mm.template get_destination_cooperative_tensor<decltype(tB), decltype(tU0), float>();
+    for (uint16_t i = 0; i < acc_g.get_capacity(); ++i)
+        if (acc_g.is_valid_element(i)) acc_g[i] = 0;
+    for (uint16_t i = 0; i < acc_u.get_capacity(); ++i)
+        if (acc_u.is_valid_element(i)) acc_u[i] = 0;
+
+    auto stage = [&](device const char *src0, int k, threadgroup half *tile) {
+        if (tid >= M*2) return;
+        const int row = min((int)tid/2, nr0 - 1);
+        const int col = k + 16*(tid%2);
+        device const block_q *w = (device const block_q *)(src0 +
+            (uint64_t)(expert - args.tp_expert_base)*args.nb02 +
+            (r0 + row)*args.nb01);
+        half4x4 values;
+        dequantize_func(w + col/(16*nl), (col/16)%nl, values);
+        *((threadgroup half4x4 *)(tile + (tid/2)*K + 16*(tid%2))) = values;
+    };
+    stage(src0_gate, 0, sg);
+    stage(src0_up, 0, su);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    uint buf = 0;
+    for (int k = 0; k < args.ne00; k += K) {
+        auto b = tB.slice(k, 0);
+        auto ag = (buf ? tG1 : tG0).slice(0, 0);
+        auto au = (buf ? tU1 : tU0).slice(0, 0);
+        mm.run(b, ag, acc_g);
+        mm.run(b, au, acc_u);
+        if (k + K < args.ne00) {
+            buf ^= 1;
+            stage(src0_gate, k + K, sg + buf*M*K);
+            stage(src0_up, k + K, su + buf*M*K);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    auto tC = tensor((threadgroup float *)shmem, dextents<int32_t, 2>(M, N));
+    if (SWIGLU) {
+        auto tC2 = tensor((threadgroup float *)shmem + M*N, dextents<int32_t, 2>(M, N));
+        acc_g.store(tC);
+        acc_u.store(tC2);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        const float c = act.clamp_value;
+        for (int i = tid; i < nr1*nr0; i += 128) {
+            const int id = ids[expert*args.ne21 + r1 + i/nr0];
+            const uint64_t row = (uint64_t)(id/args.ne20)*args.ne1 + (id%args.ne20);
+            const int col = r0 + i%nr0;
+            float g = ((threadgroup float *)shmem)[(i/nr0)*M + i%nr0];
+            float u = ((threadgroup float *)shmem)[M*N + (i/nr0)*M + i%nr0];
+            const float route_weight = *(device const float *)((device const char *)dst_up +
+                row * act.weight_stride);
+            if (c > 1.0e-6f) {
+                g = min(g, c);
+                u = clamp(u, -c, c);
+            }
+            const float silu = g / (1.0f + exp(-g));
+            if (MID_F16)
+                ((device half *)((device char *)dst_gate + row * act.mid_row_stride))[col] =
+                    (half)(silu * u * route_weight);
+            else
+                ((device float *)((device char *)dst_gate + row * act.mid_row_stride))[col] =
+                    silu * u * route_weight;
+        }
+        return;
+    }
+    for (int which = 0; which < 2; which++) {
+        if (which == 0) acc_g.store(tC); else acc_u.store(tC);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        device float *dst = which == 0 ? dst_gate : dst_up;
+        for (int i = tid; i < nr1*nr0; i += 128) {
+            const int id = ids[expert*args.ne21 + r1 + i/nr0];
+            dst[(uint64_t)(id/args.ne20)*args.ne1*args.ne0 +
+                (id%args.ne20)*args.ne0 + r0 + i%nr0] =
+                ((threadgroup float *)shmem)[(i/nr0)*M + i%nr0];
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+}
