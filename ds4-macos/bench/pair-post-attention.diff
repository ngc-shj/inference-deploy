+/* The first chunk's HC steps after attention, on the rows it was moved to:
+ * its residual comes back from the carry into q past both chunks' flat_norm
+ * rows (q is dead after attention, flat_norm aliases its start), and its
+ * ffn_split is written to the carry, where its expansion reads it. */
+static bool ds41_moe_pair_after_attention(ds41_gpu_graph *g, const ds4_model *m,
+                                          const ds4_layer_weights *l, uint32_t il,
+                                          uint32_t offset, uint32_t count) {
+    ds41_prefill_row *b = &g->batch, v = {0};
+    const uint64_t hc = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+    bool ok = true;
+#define DS41_PAIR_VIEW(name, width) \
+    if (ok) ok = (v.name = ds4_gpu_tensor_view(b->name, (uint64_t)count * (width) * 4u, \
+        (uint64_t)count * (width) * 4u)) != NULL;
+    DS41_PAIR_VIEW(after_attn, hc) DS41_PAIR_VIEW(block, DS4_N_EMBD)
+    DS41_PAIR_VIEW(attn_split, 24u) DS41_PAIR_VIEW(mix, 24u)
+    DS41_PAIR_VIEW(flat_norm, hc) DS41_PAIR_VIEW(x, DS4_N_EMBD)
+    DS41_PAIR_VIEW(norm, DS4_N_EMBD)
+#undef DS41_PAIR_VIEW
+    if (ok) ok = (v.residual = ds4_gpu_tensor_view(b->q, 2u * count * hc * 4u,
+                                                  count * hc * 4u)) != NULL;
+    if (ok) ok = (v.ffn_split = ds4_gpu_tensor_view(g->carry.ffn_split,
+                    (uint64_t)offset * 24u * 4u, (uint64_t)count * 24u * 4u)) != NULL;
+    if (ok) ok = g->compact_carry ?
+        ds4_gpu_dsv41_carry_copy(g->carry.residual, offset, v.residual, (uint32_t)hc, count,
+                                 DS4_V41_CARRY_BF16, false) != 0 :
+        ds4_gpu_tensor_copy(v.residual, 0, g->carry.residual, (uint64_t)offset * hc * 4u,
+                            count * hc * 4u) != 0;
+    if (ok) ok = ds41_after_attention_batch(&v, m, l, count, il);
+#define DS41_PAIR_FREE(name, width) ds4_gpu_tensor_free(v.name);
+    DS41_PREFILL_ROWS(DS41_PAIR_FREE)
+#undef DS41_PAIR_FREE
+    return ok;
+}
