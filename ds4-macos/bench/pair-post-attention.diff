+/* The router's token ids for both chunks' rows, in their order in the paired
+ * dispatches: the second chunk's, then the first's. */
+static bool ds41_moe_pair_tokens(const int *tokens, uint32_t first, uint32_t count,
+                                 ds4_gpu_tensor **out) {
+    static ds4_gpu_tensor *ids;
+    static uint64_t ids_bytes;
+    const uint64_t bytes = 2u * (uint64_t)count * sizeof(int32_t);
+    if (!ids || ids_bytes < bytes) {
+        ds4_gpu_tensor_free(ids);
+        ids = ds4_gpu_tensor_alloc(bytes);
+        ids_bytes = ids ? bytes : 0;
+    }
+    *out = ids;
+    return ids &&
+        ds4_gpu_tensor_write(ids, 0, tokens + first + count, (uint64_t)count * sizeof(int32_t)) &&
+        ds4_gpu_tensor_write(ids, (uint64_t)count * sizeof(int32_t), tokens + first,
+                             (uint64_t)count * sizeof(int32_t));
+}
