+        const uint64_t row_bytes = 512u * sizeof(float);
+        const ds4_gpu_get_rows_args args = {
+            .ne00t = 512, .ne00 = 512, .nb01 = row_bytes,
+            .nb02 = (uint64_t)source_rows * row_bytes,
+            .nb03 = (uint64_t)source_rows * row_bytes,
+            .ne10 = (int32_t)total, .nb10 = sizeof(int32_t),
+            .nb11 = (uint64_t)total * sizeof(int32_t),
+            .nb12 = (uint64_t)total * sizeof(int32_t),
+            .nb1 = row_bytes, .nb2 = (uint64_t)total * row_bytes,
+            .nb3 = (uint64_t)total * row_bytes,
+        };
+        int owned = 0;
+        DS4Cmd *cb = ds4_gpu_command_buffer(&owned);
+        DS4Enc *enc = cb ? ds4_gpu_compute_encoder(cb) : nil;
+        if (!enc) return 0;
+        ds4_enc_pso(enc, g_get_rows_f32_pipeline);
+        ds4_enc_bytes(enc, &args, sizeof(args), 0);
+        const ds4_gpu_tensor *inputs[] = {source, ids, out};
+        for (NSUInteger i = 0; i < 3; i++)
+            ds4_enc_buf_n(enc, ds4_gpu_tensor_buffer(inputs[i]), ds4_gpu_tensor_offset(inputs[i]), ds4_tensor_tail(inputs[i], ds4_gpu_tensor_offset(inputs[i])), i + 1);
+        ds4_gpu_dispatch(enc, MTLSizeMake(2u * (NSUInteger)total, 1, 1), MTLSizeMake(256, 1, 1));
+        ds4_gpu_end_compute_encoder(cb, enc);
+        return ds4_gpu_finish_command_buffer(cb, owned, "V4.1 sparse KV gather rows");
+    }
+}
