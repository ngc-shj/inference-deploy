 }
 
+// A row tile's flash KV staging in one dispatch: row r's slot (slot_halves
+// apart) takes the raw keys from raw_start + r, n_raw of them, then its own
+// compressed keys (comp_floats apart), each converted to half as
+// kernel_cpy_contig_f32_f16_4 converts it. The raw window must not wrap.
+struct ds4_metal_args_dsv41_kv_stage_rows {
+    uint n_raw, n_comp, raw_start, rows;
+    uint slot_halves, comp_floats, dim;
+};
+
+kernel void kernel_dsv41_kv_stage_rows_f16(
+        constant ds4_metal_args_dsv41_kv_stage_rows &args,
+        device const float *raw,
+        device const float *comp,
+        device half *dst,
+        uint2 tg_ [[threadgroup_position_in_grid]], uint2 tid_ [[thread_position_in_threadgroup]], uint2 ntg_ [[threads_per_threadgroup]]) {
+    const uint2 index = tg_ * ntg_ + tid_; /* through the threadgroup: see kernel_swiglu_flat_f32 */
+    const uint row = index.y;
+    const uint per_key = args.dim / 4u;
+    if (row >= args.rows || index.x >= (args.n_raw + args.n_comp) * per_key) return;
+    const uint key = index.x / per_key, d4 = index.x % per_key;
+    device const float4 *src = key < args.n_raw
+        ? (device const float4 *)(raw + (ulong)(args.raw_start + row + key) * args.dim) + d4
+        : (device const float4 *)(comp + (ulong)row * args.comp_floats +
+                                  (ulong)(key - args.n_raw) * args.dim) + d4;
+    const float4 value = float4(*(device const packed_float4 *)src);
+    *((device packed_half4 *)(dst + (ulong)row * args.slot_halves + (ulong)key * args.dim) + d4) =
+        packed_half4(half4(value));
+}
+
 struct ds4_metal_args_dsv41_carry {
     uint width, rows, words, format, pack;
 };
