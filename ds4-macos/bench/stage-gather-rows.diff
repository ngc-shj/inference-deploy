+/* ds4_gpu_dsv41_gather_kv over `rows` block rows at once, each with
+ * `selected` ids (the rows' ids and outputs contiguous): one get_rows of
+ * rows * selected rows, the same copy a row's call makes. */
+int ds4_gpu_dsv41_gather_kv_rows(ds4_gpu_tensor *out, const ds4_gpu_tensor *source,
+                                 const ds4_gpu_tensor *ids, uint32_t source_rows,
+                                 uint32_t selected, uint32_t rows) {
+    if (!rows || !selected || selected > 512u || rows > UINT32_MAX / selected) return 0;
+    const uint32_t total = selected * rows;
+    if (!source_rows || selected > source_rows ||
+        !dsv41_tensor_has_floats(source, (uint64_t)source_rows * 512u) ||
+        !dsv41_tensor_has_floats(out, (uint64_t)total * 512u) ||
+        !dsv41_tensor_has_floats(ids, total)) return 0;
+    if (!g_initialized && !ds4_gpu_init()) return 0;
