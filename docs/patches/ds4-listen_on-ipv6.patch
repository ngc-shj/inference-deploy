 static int listen_on(const char *host, int port) {
-    int fd = socket(AF_INET, SOCK_STREAM, 0);
-    if (fd < 0) return -1;
-    int yes = 1;
-    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes));
-
-    struct sockaddr_in sa;
-    memset(&sa, 0, sizeof(sa));
-    sa.sin_family = AF_INET;
-    sa.sin_port = htons((uint16_t)port);
+    /* getaddrinfo() rather than inet_pton(AF_INET, ...) so --host accepts IPv6
+     * literals and hostnames as well as the IPv4 literals it always took.
+     * "localhost" keeps mapping to 127.0.0.1: resolving it would usually pick
+     * ::1 first, and a client dialling 127.0.0.1 would then find nothing
+     * listening. "::" binds dual-stack, so it is the IPv6 spelling of the
+     * catch-everything that 0.0.0.0 gives for IPv4 alone. */
     if (!strcmp(host, "localhost")) host = "127.0.0.1";
-    if (inet_pton(AF_INET, host, &sa.sin_addr) != 1) {
-        close(fd);
+
+    char service[16];
+    snprintf(service, sizeof(service), "%d", port);
+
+    struct addrinfo hints;
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+    hints.ai_flags = AI_PASSIVE | AI_NUMERICSERV;
+
+    struct addrinfo *res = NULL;
+    if (getaddrinfo(host, service, &hints, &res) != 0 || res == NULL) {
         errno = EINVAL;
         return -1;
     }
-    if (bind(fd, (struct sockaddr *)&sa, sizeof(sa)) != 0) {
-        close(fd);
-        return -1;
-    }
-    if (listen(fd, 128) != 0) {
+
+    int fd = -1;
+    for (struct addrinfo *ai = res; ai != NULL; ai = ai->ai_next) {
+        fd = socket(ai->ai_family, ai->ai_socktype, ai->ai_protocol);
+        if (fd < 0) continue;
+
+        int yes = 1;
+        setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes));
+        if (ai->ai_family == AF_INET6) {
+            /* Accept mapped IPv4 on the wildcard so "::" serves both stacks.
+             * Harmless on a specific address, which stays IPv6-only anyway. */
+            int off = 0;
+            setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, &off, sizeof(off));
+        }
+
+        if (bind(fd, ai->ai_addr, ai->ai_addrlen) == 0 &&
+            listen(fd, 128) == 0)
+        {
+            break;
+        }
         close(fd);
-        return -1;
+        fd = -1;
     }
+
+    freeaddrinfo(res);
     return fd;
 }
 
