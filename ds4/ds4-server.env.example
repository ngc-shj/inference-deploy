# Runtime arguments for ds4-server, passed verbatim (word-split) by systemd.
# Copy to /etc/ds4/ds4-server.env and edit, then:
#   sudo systemctl restart ds4-server
#
# host 127.0.0.1 keeps the API local-only. Change to 0.0.0.0 to expose on the
# LAN (then firewall the port; the server has no auth). The model path is the
# stable alias that install.sh creates in /var/lib/ds4/models.

#
# DeepSeek V4.1 Flash Q2 (341 GiB, main weights 152 GiB) cannot load resident on
# a 128 GB box: --ssd-streaming is required, and upstream validates --ctx up to
# 65536 there (32768 recommended). DSpark and vision are not available for V4.1
# on CUDA.
#
# --ssd-streaming-cache-experts 64GB: the automatic budget (80% of the CUDA
# working set, ~104 GiB planned) assumes nothing else runs; on this box it
# pushed swap +5.8 GiB and logged NVRM NV_ERR_NO_MEMORY. 64GB plans ~81 GiB and
# kept swap under 1 GiB, at 14-29% slower decode. See EVALUATIONS.md.

DS4_SERVER_ARGS="--host 127.0.0.1 --port 8000 --cuda --ssd-streaming --ssd-streaming-cache-experts 64GB --ctx 32768 -m /var/lib/ds4/models/ds4flash.gguf --kv-disk-dir /var/lib/ds4/kv --kv-disk-space-mb 8192"
